        <!-- Info Box -->
        <div class="info-container">
            <div class="info-head">
                <h2>INFORMASI SITUS MPO777</h2>
            </div>
            <div class="info-list">
                <div class="info-row">
                    <div class="info-label">
                        <span class="info-dot"></span>
                        <span class="info-text">Penilaian Pengguna</span>
